figure('Name', 'Trajectory Viewer');
grid on; hold on;
xlabel('X'); ylabel('Y');
title('Real-time trajSet visualization + Collision Info');
axis equal;

while true

    cla;  % 그림 초기화
    grid on; hold on;

    legendHandles = [];
    legendNames   = {};

    % === Candidate trajectories ===
    if evalin('base','exist(''trajSet'',''var'')')
        trajSet = evalin('base','trajSet');
        if ~isempty(trajSet)
            h_all = plot(trajSet{1}(:,1), trajSet{1}(:,2), '-', 'Color',[0.6 0.6 0.6]);
            legendHandles(end+1) = h_all;
            legendNames{end+1} = 'Candidate Trajectories';
            for i = 2:numel(trajSet)
                plot(trajSet{i}(:,1), trajSet{i}(:,2), '-', 'Color',[0.6 0.6 0.6]);
            end
        end
    end

    % === Optimal trajectory ===
    if evalin('base','exist(''optimal_trajSet'',''var'')')
        optTraj = evalin('base','optimal_trajSet');
        if ~isempty(optTraj)
            h_opt = plot(optTraj(:,1), optTraj(:,2), 'g-', 'LineWidth', 2.5);
            legendHandles(end+1) = h_opt;
            legendNames{end+1} = 'Optimal Trajectory';
        end
    end

    % === Obstacles predicted path ===
    if evalin('base','exist(''obsVehicle_predPath'',''var'')')
        obsPath = evalin('base','obsVehicle_predPath');
        if ~isempty(obsPath)
            h_pred = plot(obsPath{1}(:,1), obsPath{1}(:,2), 'b--');
            legendHandles(end+1) = h_pred;
            legendNames{end+1} = 'Obstacle Predicted Path';
            for i = 2:numel(obsPath)
                plot(obsPath{i}(:,1), obsPath{i}(:,2), 'b--');
            end
        end
    end

    % === Colliding path of Ego ===
    if evalin('base','exist(''egoVehicle_collidingPath'',''var'')')
        collPath = evalin('base','egoVehicle_collidingPath');
        if ~isempty(collPath)
            h_coll = plot(collPath{1}(:,1), collPath{1}(:,2), 'r--', 'LineWidth',2);
            for i = 2:numel(collPath)
                plot(collPath{i}(:,1), collPath{i}(:,2), 'r--');
            end
        end
    end
    legendHandles(end+1) = h_coll;
    legendNames{end+1} = 'Collision Path';

    % === Ego position ===
    if evalin('base','exist(''ego_global_position'',''var'')')
        egoPos = evalin('base','ego_global_position');
        x_e = egoPos(1); y_e = egoPos(2);
        yaw_e = egoPos(3);

        drawCar(x_e, y_e, yaw_e, 4, 1.8, 'k'); % Red Ego Car
    end

    % === Obs initial positions ===
    if evalin('base','exist(''obsVehicle_position'',''var'')')
        obsPos = evalin('base','obsVehicle_position');
        for i = 1:numel(obsPos)
            p = obsPos{i};
            drawCar(p(1), p(2), p(3), 4, 1.8, 'b'); % Black Obstacle Car

            % Optional: text label
            text(p(1)+0.5,p(2)+0.5,sprintf('Obs %d',i),...
                'FontSize',8,'Color','k');
        end
    end

    % === Apply Legend ===
    if ~isempty(legendHandles)
        legend(legendHandles, legendNames, 'Location','best');
    end

    drawnow;
    pause(0.01);

end


function drawCar(x, y, yaw, L, W, color)
    % Car half dimensions
    hl = L/2;
    hw = W/2;

    % Rectangle corners in local car coordinates
    corners = [ hl,  hw;
                hl, -hw;
               -hl, -hw;
               -hl,  hw]';

    % Rotation matrix
    R = [cos(yaw) -sin(yaw);
         sin(yaw)  cos(yaw)];

    % Transform to global coordinates
    corners_global = R * corners + [x; y];

    % Close rectangle path
    corners_global = [corners_global, corners_global(:,1)];

    plot(corners_global(1,:), corners_global(2,:), 'Color', color, 'LineWidth', 1.5);
end
